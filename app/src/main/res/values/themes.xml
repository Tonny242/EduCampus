<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EduCampus" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/background_main</item>
        <item name="colorSurface">@color/background_card</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.EduCampus" parent="Base.Theme.EduCampus" />

    <!-- Custom Styles -->
    <style name="Widget.EduCampus.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.EduCampus.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.EduCampus.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_secondary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EduCampus.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.EduCampus.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.EduCampus.SmallComponent</item>
    </style>

    <style name="ShapeAppearance.EduCampus.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/button_corner_radius</item>
    </style>

    <style name="ShapeAppearance.EduCampus.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/spacing_small</item>
    </style>

    <style name="ThemeOverlay.EduCampus.Secondary" parent="">
        <item name="colorPrimary">@color/brand_secondary</item>
    </style>

    <style name="TextTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_h1</item>
    </style>

    <style name="TextSubtitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

</resources>