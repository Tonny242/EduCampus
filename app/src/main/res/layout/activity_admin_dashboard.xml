<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large"
        android:background="@color/background_main">

        <TextView
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Espace Administrateur"
            android:textSize="@dimen/text_size_h2" />

        <TextView
            android:id="@+id/tvAdminName"
            style="@style/TextSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="Bienvenue" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminEtudiants"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nÉtudiants"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminCours"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nCours"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminEnseignants"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nEnseignants"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminEmploi"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nEmploi"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminNotes"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nNotes"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminAnnonces"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="@dimen/spacing_small"
                android:text="Gestion\nAnnonces"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.EduCampus.SmallComponent"
                android:textColor="@color/brand_primary" />

        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminLogout"
            style="@style/Widget.EduCampus.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xlarge"
            android:text="Se déconnecter"
            android:padding="@dimen/spacing_medium" />

    </LinearLayout>

</ScrollView>