<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvMatiere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Matière"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/brand_primary" />

        <TextView
            android:id="@+id/tvSemestre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:text="Semestre"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvCc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CC: —"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/tvExamen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Exam: —"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/tvMoyenne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOY: —"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold"
                android:textColor="@color/brand_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCoefficient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:text="Coefficient: —"
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/text_hint" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
